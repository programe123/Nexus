{
  "name": "nexus-energy-ai",
  "version": "1.0.0",
  "description": "Interactive frontend for the NEXUS ENERGY AI smart energy management platform.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "server": "npm --prefix server run dev",
    "server:test": "npm --prefix server test",
    "server:build": "npm --prefix server run build",
    "dev:all": "concurrently -n web,server -c cyan,yellow \"npm run dev\" \"npm run server\""
  },
  "keywords": [
    "energy",
    "dashboard",
    "frontend"
  ],
  "author": "",
  "dependencies": {
    "framer-motion": "11.11.17",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "^2.1.9"
  }
}
