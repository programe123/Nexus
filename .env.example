# NEXUS ENERGY AI - data integration configuration
# Copy this file to `.env` and fill in the values you have.
# All entries are optional - the app runs with zero configuration
# (live Open-Meteo weather + simulated carbon) out of the box.

# --- Weather (free, no key required) ---
# Location used for the Open-Meteo weather feed.
VITE_LOCATION_NAME="New Delhi, India"
VITE_LOCATION_LAT="28.6139"
VITE_LOCATION_LON="77.209"

# --- Grid carbon intensity ---
# Provider options: uk | electricitymaps | auto | simulated
#   uk             - National Grid ESO, free, no key, UK grid only
#   electricitymaps- needs VITE_ELECTRICITY_MAPS_TOKEN (free tier: electricitymaps.com)
#   auto           - try Electricity Maps (if a token is set), then fall back to UK
#   simulated      - local simulator only, no network calls
VITE_CARBON_PROVIDER="uk"

# Free API token from https://www.electricitymaps.com (signup -> API token)
VITE_ELECTRICITY_MAPS_TOKEN=""

# Grid zone for Electricity Maps, e.g. IN-NO (India north), IN-WR, GB, DE-SO
VITE_GRID_ZONE="IN-NO"
